    {
      "number": 5,
      "id": "PR_kwDOU86eg88AAAABG0anWg",
      "title": "Clarify that credit updates are deltas and forbid a delta of 0",
      "url": "https://github.com/afrind/draft-frindell-moq-subscription-flow-control/pull/5",
